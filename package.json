{
  "name": "@tinybig-ai/jep",
  "version": "0.2.0",
  "type": "module",
  "description": "One interface for every coding agent: a hexagonal core with Telegram, Android and gateway clients (opencode, codex, claude)",
  "license": "MIT",
  "author": "Cemre Karakas",
  "homepage": "https://github.com/tinybig-ai/jep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinybig-ai/jep.git"
  },
  "bugs": {
    "url": "https://github.com/tinybig-ai/jep/issues"
  },
  "keywords": [
    "coding-agent",
    "opencode",
    "claude-code",
    "codex",
    "remote-control",
    "telegram",
    "android",
    "ios"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jep": "bin/jep.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "fixture",
    "scripts",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/app/tg.ts",
    "tg": "node --experimental-strip-types src/app/tg.ts",
    "tg:mock": "JEP_HARNESS=${JEP_HARNESS:-echo} JEP_TG_PAIR_CODE=TESTCODE JEP_TG_MOCK=1 node --experimental-strip-types src/app/tg.ts < fixture/telegram-mock.jsonl",
    "probe": "node --experimental-strip-types src/app/probe.ts",
    "probe:harness": "node --experimental-strip-types src/app/probe-harness.ts",
    "pair": "node --experimental-strip-types src/app/paircode.ts",
    "unpair": "node --experimental-strip-types src/app/unpair.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "JEP_E2E=1 node --test --test-timeout=300000 test/e2e.test.ts",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "undici": "^8.10.2"
  }
}
